# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=isopulse
POSTGRES_PASSWORD=isopulse_secret
POSTGRES_DB=iso_pulse
DATABASE_URL=postgresql+asyncpg://isopulse:isopulse_secret@postgres:5432/iso_pulse

# ─── ChromaDB ────────────────────────────────────────────────────────────────
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# ─── Ollama ──────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b

# ─── E-posta (MailHog dev | Resend prod) ─────────────────────────────────────
SMTP_HOST=smtp_dev
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@isopulse.local

# ─── Uygulama ─────────────────────────────────────────────────────────────────
SECRET_KEY=change_me_in_production_32_chars_min
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000

# ─── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
