# Fast Mock = true skips OpenAI. Set false for live ChatOpenAI (gpt-4o-mini).
ISO_PULSE_USE_MOCK_LLM=false

# OpenAI (required for live LLM synthesis)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ISO_PULSE_MODEL=gpt-4o-mini
ISO_PULSE_TEMPERATURE=0

# ChromaDB / local embeddings
CHROMA_PERSIST_DIR=data/chroma_db
CHROMA_COLLECTION=iso_mevzuat_baseline
EMBEDDING_MODEL=BAAI/bge-m3
# Optional: Hugging Face Inference API key (local SentenceTransformer is used if unset)
# HF_TOKEN=

# Daily ingestion output
DAILY_UPDATES_DIR=data/daily_updates
REPORTS_DIR=data/reports
DAILY_CACHE_PATH=data/daily_revisions_cache.sqlite
