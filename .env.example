# Mock LLM modunu kapatıp yerel Ollama'ya geçiyoruz
ISO_PULSE_USE_MOCK_LLM=false

# Ollama / Yerel Model Ayarları
OLLAMA_BASE_URL=http://localhost:11434
MODEL_NAME=qwen2.5:7b

# OpenAI Ayarları (İleride gerekirse kullanılmak üzere)
OPENAI_API_KEY=
ISO_PULSE_MODEL=gpt-4o-mini
ISO_PULSE_TEMPERATURE=0

# ChromaDB / local embeddings
CHROMA_PERSIST_DIR=data/chroma_db
CHROMA_COLLECTION=iso_mevzuat_baseline
EMBEDDING_MODEL=BAAI/bge-m3
# Optional: Hugging Face Inference API key (local SentenceTransformer is used if unset)
# HF_TOKEN=

# Daily ingestion output
DAILY_UPDATES_DIR=data/daily_updates
REPORTS_DIR=data/reports