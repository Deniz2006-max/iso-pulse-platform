# Default: run the graph with deterministic mock LLM responses (no API key needed).
ISO_PULSE_USE_MOCK_LLM=true

# Used only when ISO_PULSE_USE_MOCK_LLM=false
OPENAI_API_KEY=
ISO_PULSE_MODEL=gpt-4o-mini
ISO_PULSE_TEMPERATURE=0

# PostgreSQL (docker compose postgres service)
POSTGRES_USER=iso_pulse
POSTGRES_PASSWORD=iso_pulse
POSTGRES_DB=iso_pulse
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://iso_pulse:iso_pulse@localhost:5432/iso_pulse
